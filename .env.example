# Required — Gemini API key (https://aistudio.google.com)
GOOGLE_API_KEY=

# Optional — enables the 3 web search tools (https://tavily.com)
# Web search tools are skipped if unset.
TAVILY_API_KEY=

# Optional — override the primary Gemini model.
# Leave blank to use the built-in fallback chain below.
GEMINI_MODEL=

# Optional — comma-separated quota-aware fallback chain.
# Default: gemini-2.5-flash,gemini-2.0-flash,gemini-2.0-flash-lite
GEMINI_FALLBACK_MODELS=
